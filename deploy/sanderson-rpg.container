[Unit]
Description=Sanderson RPG Character Management System
After=network-online.target

[Container]
Image=localhost/sanderson-rpg:latest
PublishPort=80:3000
Volume=sanderson-rpg-db:/app/prisma
Volume=sanderson-rpg-characters:/app/server/characters
Volume=sanderson-rpg-images:/app/server/images
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_URL=file:./prisma/dev.db
HealthCmd=curl -f http://localhost:3000/api/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=15s

[Service]
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
